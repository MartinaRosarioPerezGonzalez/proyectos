# IBM watsonx.ai credentials
WATSONX_API_KEY=s
WATSONX_PROJECT_ID=
WATSONX_URL=

# Server
PORT_FASTAPI=4051

# Recommendation engine — income thresholds (ARS, not exposed in API responses)
# INGRESO_MINIMO_HARD=300000   # Absolute floor: below this → RECHAZAR
# INGRESO_MINIMO_SOFT=600000   # Preferred floor: below this → REVISAR

# Mortgage eligibility — property matching rules (not exposed in API responses)
# TASA_CUOTA_MENSUAL=0.0030    # Monthly instalment factor: cuota = precio × factor (Programa +Hogares 30 años)
# RATIO_CUOTA_MAX=0.35         # Max cuota/sueldo-neto ratio allowed (35% = BNA Hogares)

# Gmail — decision notification emails (personas workflow)
GMAIL_USER=
GMAIL_APP_PASSWORD=
